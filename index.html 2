<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Happy 18th Nuha! 🐱🍦</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐱</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--pink:#ffd6e7;--lav:#e4dafc;--mint:#d4f4e4;--butter:#fff1b8;--ink:#5a3b52;--hot:#ff7aa8;--hot2:#ff5c93;--card:#fffafc}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;min-height:100%}
body{font-family:'Quicksand','Trebuchet MS',system-ui,sans-serif;color:var(--ink);background:linear-gradient(160deg,var(--pink),var(--lav) 50%,var(--mint));background-attachment:fixed;overflow-x:hidden;padding-bottom:40px}
h1,h2,.btn{font-family:'Baloo 2','Trebuchet MS',system-ui,sans-serif}
#floaters{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:0}
#floaters span{position:absolute;bottom:-60px;opacity:.5;animation:rise linear infinite}
@keyframes rise{to{transform:translateY(-115vh) rotate(40deg)}}
#fx{position:fixed;inset:0;pointer-events:none;z-index:90}
.paw{position:fixed;pointer-events:none;z-index:80;font-size:16px;animation:fade .9s forwards}
@keyframes fade{to{opacity:0;transform:translateY(-14px) scale(.6)}}
#hud{position:sticky;top:0;z-index:20;display:flex;gap:8px;justify-content:center;flex-wrap:wrap;padding:10px 10px 6px}
.pill{background:rgba(255,255,255,.85);border:2px solid #fff;border-radius:99px;padding:5px 12px;font-weight:700;font-size:13px;box-shadow:0 3px 0 rgba(255,122,168,.25);display:flex;align-items:center;gap:6px;color:var(--ink);font-family:inherit}
button.pill{cursor:pointer}
.bar{width:70px;height:10px;background:#f1dbe6;border-radius:9px;overflow:hidden}
.bar i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#ff9ec0,#ffd36e);transition:width .5s}
#prog{position:relative;z-index:2;height:8px;max-width:560px;margin:4px auto 0;background:rgba(255,255,255,.6);border-radius:9px;overflow:hidden}
#prog i{display:block;height:100%;width:0;background:var(--hot);transition:width .5s;border-radius:9px}
#wrap{position:relative;z-index:2;max-width:560px;margin:46px auto 0;padding:0 16px}
.card{position:relative;background:var(--card);border-radius:34px;padding:30px 22px 26px;text-align:center;box-shadow:0 8px 0 rgba(255,122,168,.28),0 20px 40px rgba(120,80,140,.15);border:4px solid #fff;animation:in .5s}
@keyframes in{from{opacity:0;transform:translateY(14px) scale(.97)}}
.card:before,.card:after{content:"";position:absolute;top:-30px;width:60px;height:56px;background:var(--card);border:4px solid #fff;border-bottom:0;clip-path:polygon(0 100%,50% 0,100% 100%);z-index:-1}
.card:before{left:34px;transform:rotate(-10deg)}.card:after{right:34px;transform:rotate(10deg)}
.card .face{position:absolute;top:-4px;left:50%;transform:translateX(-50%);font-size:12px;opacity:.0}
h1{font-size:clamp(30px,8vw,46px);line-height:1.05;margin:6px 0 10px;color:var(--hot2)}
h2{font-size:clamp(22px,5.6vw,28px);line-height:1.15;margin:4px 0 6px}
.sub{margin:0 0 16px;font-weight:700;opacity:.75;font-size:15px}
.emoji{font-size:54px;display:block;animation:bob 2.4s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-8px) rotate(-4deg)}}
.btn{border:0;border-radius:99px;padding:12px 22px;font-size:18px;font-weight:800;cursor:pointer;color:var(--ink);transition:transform .15s,box-shadow .15s}
.main{background:linear-gradient(180deg,#ff9ec0,var(--hot));color:#fff;box-shadow:0 5px 0 #d94f7f;margin:8px 4px}
.main:active{box-shadow:0 1px 0 #d94f7f;transform:translateY(4px)}
.main:disabled{opacity:.55}
.opt{display:block;width:100%;margin:10px 0;background:#fff;border:3px solid var(--pink);box-shadow:0 4px 0 var(--pink);font-size:17px}
.opt:hover:not(:disabled){transform:translateY(-2px) rotate(-.6deg);border-color:var(--hot)}
.opt:disabled{opacity:.6;cursor:default}
.opt:focus-visible,.main:focus-visible,.pill:focus-visible{outline:3px solid #7a5cff;outline-offset:2px}
#roast{min-height:0;margin-top:14px;background:var(--butter);border-radius:20px;padding:0;font-weight:700;font-size:15px;text-align:left;overflow:hidden;max-height:0}
#roast.pop{padding:12px 16px;max-height:340px;animation:wob .5s;border:3px dashed #f3c75f}
@keyframes wob{25%{transform:rotate(-2deg)}75%{transform:rotate(2deg)}}
.big{position:relative;height:34px;border-radius:99px;background:#f1dbe6;overflow:hidden;margin:8px 0 14px;border:3px solid #fff;box-shadow:inset 0 2px 4px rgba(0,0,0,.1)}
.big i{position:absolute;left:0;top:0;bottom:0;width:0;background:linear-gradient(90deg,#ff9ec0,#ffd36e);transition:width .25s}
.big span{position:relative;font-weight:800;line-height:28px;font-size:14px}
.val{font-size:30px;font-weight:800;color:var(--hot2);font-family:'Baloo 2',sans-serif}
input[type=range]{width:100%;accent-color:var(--hot);height:30px}
.shake{animation:sh .4s}
@keyframes sh{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
.tower{display:flex;flex-direction:column-reverse;align-items:center;min-height:130px;margin:6px 0}
.scoop{width:70px;height:46px;border-radius:50% 50% 45% 45%;margin-bottom:-18px;animation:drop .35s;box-shadow:inset -6px -6px 0 rgba(0,0,0,.07)}
.cone{width:0;height:0;border-left:34px solid transparent;border-right:34px solid transparent;border-top:80px solid #e8b268;z-index:0}
@keyframes drop{from{transform:translateY(-60px);opacity:0}}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0}
.stats div{background:var(--lav);border-radius:18px;padding:10px 4px;font-size:12px;font-weight:700}
.stats b{display:block;font-size:26px;font-family:'Baloo 2',sans-serif;color:var(--hot2)}
.wish{text-align:left;background:#fff;border-radius:20px;padding:12px 16px;margin:10px 0;font-weight:700;border-left:8px solid var(--hot)}
.small{font-size:13px;opacity:.7;margin-top:14px}
.iq{display:block;margin-top:7px;font-style:italic;opacity:.85}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:6px 0 12px}
.tile{font-size:34px;padding:10px;border-radius:16px;border:3px solid var(--pink);background:#fff;cursor:pointer;transition:transform .15s}
.tile.on{border-color:var(--hot);background:var(--pink);transform:scale(.92)}
.txt{width:100%;padding:12px 16px;border-radius:99px;border:3px solid var(--pink);font:inherit;font-size:18px;text-align:center;color:var(--ink);margin-bottom:6px;background:#fff}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="floaters"></div>
<canvas id="fx"></canvas>
<header id="hud">
  <div class="pill">🧠 <span>Brain cells: <b>1</b></span><div class="bar"><i id="en"></i></div><span id="enl">fresh</span></div>
  <div class="pill" id="qn">Intro</div>
  <button class="pill" id="mute" aria-label="Toggle sound effects">🔊</button>
  <button class="pill" id="mus" aria-label="Toggle music">🎵</button>
</header>
<div id="prog"><i id="pi"></i></div>
<main id="wrap"><section class="card" id="card"><div id="stage"></div></section></main>

<script>
(()=>{
"use strict";
/* ===== EDIT ME ===== */
const NAME="Nuha";
const FROM="your favourite human";
const WISHES=[
 "May Allah bless you with good health, a happy heart and a long life full of barakah. 🤲",
 "May Allah reward you for every good deed and make every step of your 18th year easy for you. 🌙",
 "May Allah grant you success in your studies, your career and in every dream you carry in your heart. ✨",
 "May Allah surround you with kind and loyal people, protect you from all harm and fill your heart with peace. 💖",
 "May Allah keep you close to Him, forgive your mistakes and make you a source of joy for your family and friends. 🕌",
 "And may your life always be full of cats, ice cream and good music. Ameen! 🐱🍦🎵"
];
/* =================== */
const $=s=>document.querySelector(s);
const mk=(t,c,h)=>{const e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e;};
const rnd=(a,b)=>a+Math.random()*(b-a);
const pick=a=>a[Math.floor(Math.random()*a.length)];
let AC=null,sound=true,idx=-1,fooled=0,clicks=0;

/* ---------- sound ---------- */
function ctx(){try{AC=AC||new (window.AudioContext||window.webkitAudioContext)();if(AC.state==="suspended")AC.resume();return AC;}catch(e){return null;}}
function beep(f,d,type,v){if(!sound)return;const c=ctx();if(!c)return;try{const o=c.createOscillator(),g=c.createGain();o.type=type||"sine";o.frequency.value=f;g.gain.value=v||.05;o.connect(g);g.connect(c.destination);o.start();g.gain.exponentialRampToValueAtTime(.0001,c.currentTime+(d||.12));o.stop(c.currentTime+(d||.12)+.03);}catch(e){}}
function meow(){if(!sound)return;const c=ctx();if(!c)return;try{const o=c.createOscillator(),g=c.createGain();o.type="sawtooth";o.frequency.setValueAtTime(650,c.currentTime);o.frequency.linearRampToValueAtTime(900,c.currentTime+.12);o.frequency.linearRampToValueAtTime(420,c.currentTime+.45);g.gain.setValueAtTime(.05,c.currentTime);g.gain.exponentialRampToValueAtTime(.0001,c.currentTime+.5);o.connect(g);g.connect(c.destination);o.start();o.stop(c.currentTime+.55);}catch(e){}}
function melody(){if(!sound)return;const N=[[392,.3],[392,.15],[440,.45],[392,.45],[523,.45],[494,.9],[392,.3],[392,.15],[440,.45],[392,.45],[587,.45],[523,.9],[392,.3],[392,.15],[784,.45],[659,.45],[523,.45],[494,.45],[440,.6],[698,.3],[698,.15],[659,.45],[523,.45],[587,.45],[523,.9]];let t=0;N.forEach(n=>{setTimeout(()=>beep(n[0],n[1]*1.1,"triangle",.07),t*1000);t+=n[1]+.04;});}
function seq(a,gap,type,v){a.forEach((f,i)=>setTimeout(()=>beep(f,.14,type,v),i*gap));}
function sweep(f1,f2,d){if(!sound)return;const c=ctx();if(!c)return;try{const o=c.createOscillator(),g=c.createGain();o.type="sine";o.frequency.setValueAtTime(f1,c.currentTime);o.frequency.exponentialRampToValueAtTime(f2,c.currentTime+d);g.gain.setValueAtTime(.05,c.currentTime);g.gain.exponentialRampToValueAtTime(.0001,c.currentTime+d);o.connect(g);g.connect(c.destination);o.start();o.stop(c.currentTime+d+.02);}catch(e){}}
let music=true,mTimer=null,mStep=0,mNext=0;
const SC=[523.25,587.33,659.25,784,880,1046.5],BASS=[130.81,110,87.31,98];
const PAT=[0,2,4,2,5,4,2,1, 0,2,4,5,4,2,1,0, 2,4,5,4,2,0,1,2, 4,2,1,0,1,2,0,-1,
           0,2,4,5,4,2,4,5, 5,4,2,1,0,1,2,4, 2,4,5,4,2,4,1,0, 1,2,4,2,1,0,0,-1];
function note(f,t,d,type,v){try{const o=AC.createOscillator(),g=AC.createGain();o.type=type;o.frequency.value=f;g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(g);g.connect(AC.destination);o.start(t);o.stop(t+d+.02);}catch(e){}}
function musicTick(){if(!music||!AC)return;while(mNext<AC.currentTime+.5){const st=mStep%PAT.length,n=PAT[st];if(n>=0)note(SC[n],mNext,.55,"triangle",.03);if(st%8===0)note(BASS[Math.floor(st/8)%4],mNext,1.9,"sine",.05);if(st%4===2)note(SC[(n<0?0:n)]/2,mNext,.25,"sine",.012);mNext+=.3;mStep++;}}
function startMusic(){if(!music||mTimer)return;const c=ctx();if(!c)return;mNext=c.currentTime+.1;mTimer=setInterval(musicTick,150);}
function stopMusic(){clearInterval(mTimer);mTimer=null;}
$("#mus").onclick=e=>{music=!music;e.currentTarget.textContent=music?"🎵":"🔕";if(music)startMusic();else stopMusic();};
$("#mute").onclick=e=>{sound=!sound;e.currentTarget.textContent=sound?"🔊":"🔇";};
document.addEventListener("pointerdown",e=>{clicks++;startMusic();const sp=mk("span","paw","✨");sp.style.left=e.clientX+"px";sp.style.top=e.clientY+"px";document.body.append(sp);setTimeout(()=>sp.remove(),950);beep(rnd(500,800),.07,"triangle",.035);});

/* ---------- background ---------- */
(function(){const f=$("#floaters");["🐱","🍦","🎵","🐾","🎂","💖","🎧","😸","🍨","✨"].forEach((e,i)=>{for(let k=0;k<2;k++){const s=mk("span",null,e);s.style.left=rnd(0,96)+"%";s.style.fontSize=rnd(20,44)+"px";s.style.animationDuration=rnd(14,28)+"s";s.style.animationDelay=-rnd(0,24)+"s";f.append(s);}});})();
let lastPaw=0;
document.addEventListener("pointermove",e=>{const n=Date.now();if(n-lastPaw<110||e.pointerType==="touch")return;lastPaw=n;const p=mk("span","paw","🐾");p.style.left=e.clientX+"px";p.style.top=e.clientY+"px";document.body.append(p);setTimeout(()=>p.remove(),950);});

/* ---------- confetti ---------- */
const cv=$("#fx"),cx=cv.getContext("2d");let P=[],running=false;
function size(){cv.width=innerWidth;cv.height=innerHeight;}size();addEventListener("resize",size);
function burst(n,x,y){if(n>=100)seq([1200,1500,1800,2200],60,"sine",.03);const C=["#ff7aa8","#ffd36e","#9ee6c4","#b9a4ff","#fff","#7fd0ff"];for(let i=0;i<n;i++)P.push({x:x==null?innerWidth/2:x,y:y==null?innerHeight/3:y,vx:rnd(-7,7),vy:rnd(-13,-3),r:rnd(4,9),c:pick(C),a:rnd(0,6),va:rnd(-.3,.3)});if(!running){running=true;loop();}}
function loop(){cx.clearRect(0,0,cv.width,cv.height);P.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.28;p.vx*=.99;p.a+=p.va;cx.save();cx.translate(p.x,p.y);cx.rotate(p.a);cx.fillStyle=p.c;cx.fillRect(-p.r/2,-p.r/2,p.r,p.r*.6);cx.restore();});P=P.filter(p=>p.y<cv.height+20);if(P.length){requestAnimationFrame(loop);}else{running=false;cx.clearRect(0,0,cv.width,cv.height);}}

/* ---------- helpers ---------- */
const MOODS=["fresh","warm","sweating","confused","crying","buffering","on strike","held together by hope","legally dead"];
function hud(){const e=Math.max(4,100-fooled*5);$("#en").style.width=e+"%";$("#enl").textContent=MOODS[Math.min(MOODS.length-1,Math.floor(fooled/3))];$("#pi").style.width=Math.max(0,idx)/Q.length*100+"%";$("#qn").textContent=idx<0?"Intro":idx>=Q.length?"Done! 🎉":"Question "+(idx+1)+"/"+Q.length;}
function btn(t,c,fn){const b=mk("button","btn "+c,t);if(fn)b.onclick=fn;return b;}
const IQJ=["Fun fact: your IQ and your phone battery are both in the low single digits.","Your brain cell just texted me asking for a raise. I said no.","Scientists tried to measure your IQ. The ruler came back blank.","Your one brain cell is doing the work of zero brain cells, and it is still losing.","Somewhere, a goldfish just called you slow.","Your brain cell has been on Do Not Disturb since 2008.","Error 404: Nuha's IQ not found.","Your brain cell filed a formal complaint about its working conditions.","If brains were ice cream, yours would be one lonely sprinkle.","Even the cat solved that faster than you did.","Your brain cell is lonely. It has been waiting for a friend for 18 years.","Your IQ is not low, it is just shy. Very, very shy.","Your brain cell is trying its best. Its best is not good.","That was not a thought. That was an echo in an empty room.","Your brain cell called in sick again. It is the third time this week.","Doctors say your brain cell is trying to form a union.","Your IQ is the same as your brain cell count. One. Maybe one and a half on a good day.","Your brain cell just left a one-star review of your head.","Loading your thoughts... still loading... still loading...","Your brain has two settings: buffering and crashing."];
let IQQ=[],sinceIq=9;function iq(){if(!IQQ.length)IQQ=IQJ.slice().sort(()=>Math.random()-.5);return IQQ.pop();}
function roast(msg,q){const r=$("#roast");if(!r)return;sinceIq++;let extra="";if(sinceIq>=3&&Math.random()<.5){sinceIq=0;extra='<span class="iq">🧠 '+iq()+"</span>";}r.innerHTML="😹 "+msg+extra;r.classList.remove("pop");void r.offsetWidth;r.classList.add("pop");fooled++;hud();if(!q)seq([300,220,160],90,"square",.035);const c=$("#card");c.classList.remove("shake");void c.offsetWidth;c.classList.add("shake");}
function cont(msg,label){const w=$("#nextwrap");if(!w||w.children.length)return;roast(msg,true);document.querySelectorAll("#area .opt").forEach(x=>x.disabled=true);w.append(btn(label||"Next 🐾","main",next));seq([523,659,784],70,"triangle",.06);burst(16,innerWidth/2,innerHeight*.55);}
function choice(a,opts){opts.forEach(o=>{a.append(btn(o.t,"opt",()=>{if(o.fn)o.fn();else cont(o.r);}));});}
function dodge(b,max){let n=0;b._lock=true;const mv=()=>{if(n>=max){b._lock=false;return;}n++;sweep(350,900,.12);b.style.position="fixed";b.style.zIndex=60;b.style.width="auto";b.style.left=Math.max(6,rnd(0,innerWidth-b.offsetWidth-12))+"px";b.style.top=Math.max(80,rnd(0,innerHeight-b.offsetHeight-12))+"px";if(n>=max)b._lock=false;};b.addEventListener("pointerenter",mv);b.addEventListener("pointerdown",e=>{if(n<max){e.preventDefault();mv();}});}
function math(a,opts,rej){let t=0;opts.forEach(o=>{a.append(btn(o.t,"opt",()=>{if(o.c){if(t<2){roast(rej[t]);t++;}else cont("Okay okay. It is correct. Mark the calendar, this never happens.");}else cont(o.r);}));});}

/* ---------- the 15 questions ---------- */
const Q=[
{e:"🐱",t:"How many legs does a cat have?",s:"Take your time. Take ALL your time.",run:a=>choice(a,[
 {t:"4",r:"Correct! A rare win for Nuha, enjoy it. (It still took you 47 seconds though.)"},
 {t:"Four",r:"Correct again, and in words! Fancy. Fine, I will give you this one."},
 {t:"3, one is for emergencies",r:"Cats do not have a spare leg, you silly goose. Please go and count again."},
 {t:"I do not count legs, I count vibes",r:"Vibes cannot walk, Nuha. Neither can this answer. Sit down."}])},
{e:"🧠",t:"Is Nuha smart?",s:"Be honest. We are all watching.",run:a=>{const y=btn("Yes 😌","opt"),n=btn("No 😔","opt",()=>cont("Wow, you said No yourself. I was going to be mean about it, but you saved me the effort. 😹"));dodge(y,9);y.onclick=()=>{if(y._lock)return;cont("It took you NINE tries to say Yes to yourself. Even the button did not believe you. 😹");};a.append(y,n);}},
{e:"⚡",t:"Charge your brain",s:"Tap until the bar is full. Simple. For normal people.",run:a=>{const bar=mk("div","big","<i></i><span>0%</span>"),fl=bar.firstChild,lb=bar.lastChild;let v=0,d=0,busy=false;const M=["Aww, so close at 97%! And then it dropped. Classic Nuha. Start again. 😹","98%! And down it goes. The bar saw you tapping and lost all hope.","99%!! Then it crashed. I am not saying it is your fault, but it is totally your fault."];const up=()=>{fl.style.width=v+"%";lb.textContent=Math.floor(v)+"%";};const b=btn("TAP TAP TAP 👆","main",()=>{if(busy)return;v=Math.min(100,v+rnd(3,8));up();beep(300+v*5,.06,"triangle",.05);if(v>=96){if(d<3){busy=true;setTimeout(()=>{v=rnd(4,28);d++;up();roast(M[d-1]);busy=false;},450);}else{v=100;up();b.disabled=true;cont("FINALLY! Fully charged. Do not get excited, it will last about 4 seconds.");}}});a.append(bar,b);}},
{e:"➕",t:"1 + 1 = ?",s:"Obvious. Which is exactly the problem.",run:a=>math(a,[
 {t:"11",r:"Eleven?! Putting them side by side is not maths, Nuha. That is just standing in a queue."},
 {t:"2",c:1},
 {t:"A window",r:"A WINDOW? Of all the things in the world? I am worried about you now."},
 {t:"3, with a cat on top",r:"The cat is not a number, and also the cat is offended you used it for maths."}],
 ["WRONG! (It is 2. But you answered with way too much confidence. Try again.)","WRONG again! (Still 2.) You looked far too proud of yourself. One more time, humbly this time."])},
{e:"🍨",t:"Pick your ice cream flavour",s:"Every flavour is great. That is the trap.",run:a=>choice(a,[
 {t:"Vanilla 🤍",r:"Vanilla?? Really? That is the flavour equivalent of a plain white wall. I expected better from you."},
 {t:"Chocolate 🍫",r:"Chocolate is a safe choice. Boring, but safe. Strawberry is crying in the corner because of you."},
 {t:"Strawberry 🍓",r:"Strawberry! Great taste, honestly. A solid win for you, even if it melted a little while you were thinking."},
 {t:"Pineapple pizza flavour",r:"I need you to leave. Right now. The cat already left. Ice cream left the planet."}])},
{e:"😻",t:"Pet the cat 15 times",s:"Gentle. Consistent. Loving.",run:a=>{let c=0;const b=btn("🐱 Pet (0/15)","main");b.onclick=()=>{if(b._lock)return;if(c<15){c++;b.textContent="🐱 Pet ("+c+"/15)";beep(rnd(280,420),.1,"sine",.05);if(c%5===0)meow();if(c===15){b.textContent="🐱💨 It ran away!";roast("Fifteen pets and the cat said enough. It ran away from you, Nuha. CATCH IT!");dodge(b,4);}}else cont("You caught it! The cat is now plotting revenge for all those pets. Sleep with one eye open. 😹");};a.append(b);}},
{e:"🎧",t:"Your favourite song starts playing. You...",s:"There are no wrong answers. Only wrong people.",run:a=>choice(a,[
 {t:"Sing loudly 🎤",r:"The neighbours just filed a complaint. The cat is moving out. Great performance though."},
 {t:"Dance 💃",r:"You just tripped over absolutely nothing. A brand new world record. Congratulations."},
 {t:"Cry softly 😭",r:"Crying over a song you have heard 600 times. Respect, honestly. Also, pull yourself together."},
 {t:"Ignore it",r:"Ignoring good music?! That is a crime, Nuha. Please hand over your headphones."}])},
